# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# The token id is the public half and looks exactly like this.
# The secret is in Bitwarden under "Proxmox API token — homepage (PVEAuditor)".
#
# This token is read-only: it can see every node, VM and container, and it
# cannot start, stop or change a single thing. If it leaks, rotate it in
# Proxmox → Datacenter → Permissions → API Tokens.

PROXMOX_TOKEN_ID=root@pam!homepage
PROXMOX_TOKEN_SECRET=

# Optional
# LOG_LEVEL=INFO
# DASH_CACHE_SECONDS=5
